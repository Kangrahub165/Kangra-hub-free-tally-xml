# ==============================================================================
# Kangra Hub Free Tally XML - Environment Configuration
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development
APP_NAME="Kangra Hub Free Tally XML"
PORT=8000

# Supabase Authentication & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Global System Settings
SITE_MODE=FREE                       # Options: FREE or PAID
FREE_DAILY_PAGE_LIMIT=50             # Daily free quota per user (Asia/Kolkata reset)
MAX_UPLOAD_SIZE_MB=25                # Max PDF file size in MB
MAX_PAGES_PER_FILE=200               # Max pages per single bank statement PDF
DEFAULT_TIMEZONE=Asia/Kolkata
MAINTENANCE_MODE=false
ALLOW_NEW_SIGNUPS=true

# Admin Voluntary Support - "Buy Me a Coffee" (Section 129)
BUY_COFFEE_ENABLED=true
BUY_COFFEE_UPI_ID=your-upi-id@bank
BUY_COFFEE_PAYMENT_URL=upi://pay?pa=your-upi-id@bank&pn=Kangra%20Hub&cu=INR
BUY_COFFEE_BUTTON_TEXT="Buy Me a Coffee ☕"
BUY_COFFEE_MESSAGE="Enjoying Kangra Hub Free Tally XML? Support the project with a cup of coffee."

# SEO & Public Frontend Configuration (Section 130)
NEXT_PUBLIC_SITE_URL=https://tally.kangrahub.com
NEXT_PUBLIC_SITE_NAME="Kangra Hub Free Tally XML"
GOOGLE_SITE_VERIFICATION=your-google-verification-code
BING_SITE_VERIFICATION=your-bing-verification-code
